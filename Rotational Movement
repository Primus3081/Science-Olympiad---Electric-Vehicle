def rotate(angle):


   #PID constants
   max_speed = 6000
   kp = 2.5
   ki = 0
   kd = 0.025
  
   last_time_gyro_reading = None
   turn_rate = 0.0
   robot_angle = 0.0
   target_angle = angle
   last_time_far_from_target = None
  
   t0 = time.ticks_us()
  
   #Printing to LED Display
   display.fill(0)
   display.text(f"Turning {angle:.1f} deg", 0, 0, 1)
   display.show()
  
   last_time_far_from_target = time.ticks_ms()




   total_error = 0
   dt = 0
   prev_error = 0
  
   while True:


       # Read gyro
       if imu.gyro.data_ready():
           imu.gyro.read()
           turn_rate = imu.gyro.last_reading_dps[2]
           now = time.ticks_us()
           if last_time_gyro_reading:
               dt = time.ticks_diff(now, last_time_gyro_reading)
               if (abs((turn_rate) / 10) > 0.2):
                   robot_angle += turn_rate * dt / 1e6
           last_time_gyro_reading = now
      
       #calculate proportional gain, integral, and derivative
       error = target_angle - robot_angle
       far_from_target = abs(error) > 0.2


       total_error += error * dt / 1e6


       derivative = (error - prev_error) / (dt/1e6) if dt != 0 else 0
      
       #Check to see if robot has reached the target angle and stopped at the position for quarter of a second
       #Prevents overshooting due to momentum
       if far_from_target:
           last_time_far_from_target = time.ticks_ms()
       elif time.ticks_diff(time.ticks_ms(), last_time_far_from_target) > 250:
           motors.off()
           break


       turn_speed = error * kp + total_error * ki + derivative * kd


       #Simply a units conversion from speed (degrees per second) to motor command (value from 0-6000)
       correction = speed_to_motor(turn_speed)
      
       # If robot is still (low turn rate), apply minimum speed to overcome friction
       if abs(turn_rate) < 1.0 and abs(error) > 0.2:
           correction = 1500 if correction > 0 else -1500
      
       #Prevents impossible speeds. Not sure what happens if I don't cap it, but better safe than sorry
       if correction > max_speed:
           correction = max_speed
       if  correction < -max_speed:
           correction = -max_speed
      
       motors.set_speeds(-correction, correction)
      
       display.fill(0)
       display.text(f"Target: {target_angle:.5f}", 0, 0, 1)
       display.text(f"Angle: {robot_angle:.5f}", 0, 10, 1)
       display.text(f"Error: {error:.5f}", 0, 20, 1)
       display.text(f"Speed: {turn_speed:.5f}", 0, 30, 1)
       display.show()


       prev_error = error




      
  
   time.sleep_ms(50)
   tf = time.ticks_diff(time.ticks_us(), t0)
  
   display.fill(0)
   display.text(f"Time: {tf/1e6:.3f} sec", 0, 0, 1)
   display.text(f"Final: {robot_angle:.2f}", 0, 10, 1)
   display.text(f"Error: {error:.2f}", 0, 20, 1)
   display.show()


   return tf
