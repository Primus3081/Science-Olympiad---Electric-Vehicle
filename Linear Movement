def move_fwd(speed, distance, bias):
  base_speed = speed_to_motor(speed)
  max_motor = 6000


  kp = 350
  ki = 0
  kd = 0
  max_correction = 2000


  heading_setpoint = 0.0
  integral = 0
  last_time_gyro_reading = None
  turn_rate = 0.0


  encoders = robot.Encoders()
  encoders_per_cm = 53.58
  robot_angle = 0.0


  while True:
      if imu.gyro.data_ready():
          imu.gyro.read()
          turn_rate = imu.gyro.last_reading_dps[2]
          now = time.ticks_us()
          if last_time_gyro_reading:
              dt = time.ticks_diff(now, last_time_gyro_reading)
              if (abs(turn_rate / 10) > 0.10):
                  robot_angle += turn_rate * dt / 1e6
          last_time_gyro_reading = now


      if last_time_gyro_reading:
          error = wrap_angle_deg(heading_setpoint - robot_angle)
          derivative = -turn_rate
          correction = kp * error + ki * integral + kd * derivative
          correction = max(-max_correction, min(correction, max_correction))


          left = base_speed - correction
          right = base_speed + correction
          left = max(-max_motor, min(left, max_motor))
          right = max(-max_motor, min(right, max_motor))


          motors.set_speeds(int(left), int(right))
      else:
          motors.set_speeds(base_speed, base_speed)
          error = 0
          correction = 0


      # Check distance
      left_counts, right_counts = encoders.get_counts()
      left_dist = left_counts / encoders_per_cm
      right_dist = right_counts / encoders_per_cm
      dist_travelled = (left_dist + right_dist) / 2.0


      display.fill(0)
      display.text(f"Err: {error:.2f}", 0, 0, 1)
      display.text(f"Yaw: {robot_angle:.2f}", 0, 10, 1)
      display.text(f"Corr: {correction:.2f}", 0, 20, 1)
      display.text(f"D: {dist_travelled:.2f}", 0, 30, 1)
      display.show()


      if dist_travelled >= distance:
          motors.off()
          time.sleep_ms(50)
          break
